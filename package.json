{
  "name": "floe",
  "private": true,
  "version": "1.0.0",
  "description": "Privacy-focused personal knowledge management system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:web": "turbo build --filter=@floe/web",
    "build:mobile": "turbo build --filter=@floe/mobile",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@floe/web",
    "dev:mobile": "turbo dev --filter=@floe/mobile",
    "start:web": "turbo start --filter=@floe/web",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "type-check": "turbo type-check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo db:generate --filter=@floe/supabase",
    "db:push": "turbo db:push --filter=@floe/supabase",
    "db:reset": "turbo db:reset --filter=@floe/supabase",
    "prepare": "husky install"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.3.3",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "jest-watch-typeahead": "^2.2.2",
    "@lhci/cli": "^0.13.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "ts-jest": "^29.1.1",
    "babel-jest": "^29.7.0"
  },
  "packageManager": "npm@10.9.2"
}